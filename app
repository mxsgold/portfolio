const cfg=window.RAVE_CONFIG;const supabase=window.supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_KEY);const f=document.querySelector("#videoFile"),n=document.querySelector("#fileName"),h=document.querySelector("#fileHint"),u=document.querySelector("#videoUrl"),up=document.querySelector("#uploadBtn"),cr=document.querySelector("#createBtn"),s=document.querySelector("#status");const set=(m,c="")=>{s.textContent=m;s.className=c};f.addEventListener("change",()=>{const x=f.files[0];if(x){n.textContent=x.name;h.textContent=(x.size/1048576).toFixed(1)+" MB · "+(x.type||"video")}});up.onclick=async()=>{const x=f.files[0];if(!x)return set("Choose a video first.","error");up.disabled=cr.disabled=true;set("Uploading…");try{const path=crypto.randomUUID()+"-"+x.name.toLowerCase().replace(/[^a-z0-9._-]+/g,"-"),r=await supabase.storage.from(cfg.STORAGE_BUCKET).upload(path,x,{contentType:x.type||"video/mp4",upsert:false});if(r.error)throw r.error;u.value=supabase.storage.from(cfg.STORAGE_BUCKET).getPublicUrl(path).data.publicUrl;set("Uploaded. Create the room.","success")}catch(e){set(e.message||"Upload failed.","error")}finally{up.disabled=cr.disabled=false}};cr.onclick=()=>{if(!u.value.trim())return set("Upload a video or paste a direct video URL.","error");const id=crypto.randomUUID().slice(0,8);location.href="room.html?room="+id+"&video="+encodeURIComponent(u.value.trim())};