const cfg=window.RAVE_CONFIG;const hasConfig=cfg.SUPABASE_URL.startsWith("http")&&!cfg.SUPABASE_KEY.startsWith("YOUR_");const supabase=hasConfig?window.supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_KEY):null;const fileInput=document.querySelector("#videoFile"),fileName=document.querySelector("#fileName"),fileHint=document.querySelector("#fileHint"),videoUrl=document.querySelector("#videoUrl"),uploadBtn=document.querySelector("#uploadBtn"),createBtn=document.querySelector("#createBtn"),statusEl=document.querySelector("#status");function status(m,t=""){statusEl.textContent=m;statusEl.className=t}fileInput.addEventListener("change",()=>{const f=fileInput.files[0];if(!f)return;fileName.textContent=f.name;fileHint.textContent=(f.size/1048576).toFixed(1)+" MB · "+(f.type||"video")});uploadBtn.addEventListener("click",async()=>{const f=fileInput.files[0];if(!f)return status("Choose a video first.","error");if(!supabase)return status("Supabase is not configured.","error");uploadBtn.disabled=createBtn.disabled=true;status("Uploading…");try{const safe=f.name.toLowerCase().replace(/[^a-z0-9._-]+/g,"-"),path=crypto.randomUUID()+"-"+safe,{error}=await supabase.storage.from(cfg.STORAGE_BUCKET).upload(path,f,{cacheControl:"3600",contentType:f.type||"video/mp4",upsert:false});if(error)throw error;videoUrl.value=supabase.storage.from(cfg.STORAGE_BUCKET).getPublicUrl(path).data.publicUrl;status("Uploaded. Create the room.","success")}catch(e){console.error(e);status(e.message||"Upload failed.","error")}finally{uploadBtn.disabled=createBtn.disabled=false}});createBtn.addEventListener("click",()=>{const u=videoUrl.value.trim();if(!u)return status("Upload a video or paste a direct video URL.","error");const id=crypto.randomUUID().slice(0,8);location.href="room.html?room="+encodeURIComponent(id)+"&video="+encodeURIComponent(u)});if(!hasConfig)status("Supabase configuration is missing.","error");